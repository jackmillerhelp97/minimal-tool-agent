{
  "name": "@jackmiller/minimal-tool-agent",
  "version": "0.1.0",
  "description": "A minimal validated tool-call loop agent framework for Node and TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmillerhelp97/minimal-tool-agent.git"
  },
  "bugs": {
    "url": "https://github.com/jackmillerhelp97/minimal-tool-agent/issues"
  },
  "homepage": "https://github.com/jackmillerhelp97/minimal-tool-agent#readme"
}
